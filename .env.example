# CodeWar Environment Variables Template
# Copy this to .env and fill in your values

# Hugging Face API token for LLM-generated problems
HF_TOKEN=your_huggingface_token_here

# Database URL (for Render, this is auto-set, but useful for local development)
# Local: sqlite:///./codewar.db
# Render: auto-set via DATABASE_URL environment variable
# DATABASE_URL=postgresql://user:password@localhost/codewar

# JWT secret for authentication (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Backend API URL (for frontend to know where to call)
# Local development: http://localhost:8000
# Production on Render: https://codewar-backend.onrender.com
VITE_API_URL=http://localhost:8000
